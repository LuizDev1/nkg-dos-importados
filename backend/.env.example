NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
TRUST_PROXY=true
JSON_BODY_LIMIT=100kb
API_RATE_LIMIT=300
RATE_LIMIT_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nkg_importados
DB_USER=app_nkg
DB_PASSWORD=defina-fora-do-repositorio
DB_USER_HOST=%
# Use estas duas variáveis apenas ao executar npm run configure-db-user:
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=
DB_SSL=false

JWT_SECRET=gere-um-segredo-aleatorio-com-mais-de-32-caracteres
JWT_EXPIRES_IN=15m
JWT_ISSUER=nkg-importados-api
JWT_AUDIENCE=nkg-importados-web
SESSION_MAX_AGE_MS=900000
SESSION_COOKIE_SAME_SITE=lax
DATA_ENCRYPTION_KEY=gere-32-bytes-aleatorios-em-base64-ou-64-caracteres-hex
DATA_ENCRYPTION_KEY_ID=2026-01
DATA_ENCRYPTION_PREVIOUS_KEYS=
TURNSTILE_SECRET_KEY=chave-secreta-do-cloudflare-turnstile
TURNSTILE_EXPECTED_HOSTNAME=seudominio.com.br

MERCADOPAGO_ACCESS_TOKEN=seu_access_token_de_teste_aqui
MERCADOPAGO_PUBLIC_KEY=sua_public_key_de_teste_aqui
MERCADOPAGO_WEBHOOK_SECRET=seu_secret_do_webhook_aqui
MERCADOPAGO_WEBHOOK_URL=https://sua-url-publica.ngrok-free.dev/api/pagamentos/webhook
NGROK_AUTHTOKEN=seu_token_ngrok_aqui

MELHOR_ENVIO_TOKEN=defina-fora-do-repositorio
MELHOR_ENVIO_API_URL=https://melhorenvio.com.br/api/v2/me/shipment/calculate
MELHOR_ENVIO_USER_AGENT=NKG dos Importados (contato@exemplo.com)
CEP_ORIGEM=64900000

RESEND_API_KEY=
